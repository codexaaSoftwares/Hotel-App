# Photo Studio Management - Production Environment
# API is served from https://lvclicks.in/admin/api (same domain as frontend path)
# No CORS configuration needed since everything is on lvclicks.in

APP_NAME="Photo Studio Management"
APP_ENV=production
APP_KEY=
# IMPORTANT: Run 'php artisan key:generate' on server to generate this
APP_DEBUG=false
APP_URL=https://lvclicks.in/admin
FRONTEND_URL=https://lvclicks.in/admin

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u527636180_lv_prod_1
DB_USERNAME=u527636180_codexaa1
DB_PASSWORD=Codexaa@101

BROADCAST_DRIVER=log
# Use 'file' instead of 'redis' if Redis is not available on Hostinger
CACHE_DRIVER=file
# Use 'local' instead of 's3' if AWS S3 is not configured
FILESYSTEM_DISK=local
# Use 'sync' instead of 'redis' if Redis is not available
QUEUE_CONNECTION=sync
# Use 'file' instead of 'redis' if Redis is not available
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# Redis settings (only needed if using Redis)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@lvclicks.in
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@lvclicks.in
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=photo-studio-production
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=lvclicks.in

