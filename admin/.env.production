# Production — used by: npm run build:prod
# Update before deploy.

# Application
VITE_APP_NAME="Hotel Management App"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Hotel restaurant, room booking, billing, and reports"
VITE_APP_ENVIRONMENT="production"

# API — same-domain: path prefix (resolves to /admin/api)
# Separate API host: use full URL, e.g. https://api.example.com
VITE_API_BASE_URL=/admin/
VITE_API_TIMEOUT=30000

# Development (off in production)
VITE_DEBUG=false
VITE_LOG_LEVEL=warn
VITE_ENABLE_HOT_RELOAD=false
VITE_ENABLE_DEV_TOOLS=false

# Build
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true

# Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true

# External services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Security — production admin site origin
VITE_ENABLE_CORS=true
VITE_CORS_ORIGIN=https://admin.example.com

# File uploads
VITE_MAX_FILE_SIZE=2097152
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,webp

# Logging
VITE_LOG_ENABLE_CONSOLE=false
VITE_LOG_ENABLE_FILE=true
