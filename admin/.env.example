# Environment configuration template
# Copy to .env.local (development), .env.staging, or .env.production and update values.
#
# API base URL: use host only (e.g. http://localhost:8000) — the app appends /api automatically.
# For same-domain deploy, use a path prefix (e.g. /admin/).

# Application
VITE_APP_NAME="Hotel Management App"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Hotel restaurant, room booking, billing, and reports"
VITE_APP_ENVIRONMENT="development"

# API (Laravel backend)
VITE_API_BASE_URL="http://localhost:8000"
VITE_API_TIMEOUT="30000"

# Development
VITE_DEBUG="true"
VITE_LOG_LEVEL="debug"
VITE_ENABLE_HOT_RELOAD="true"
VITE_ENABLE_DEV_TOOLS="true"

# Build
VITE_BUILD_SOURCEMAP="true"
VITE_BUILD_MINIFY="false"

# Features
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_ERROR_REPORTING="false"

# External services (optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_SENTRY_DSN=""

# Security (dev server default port)
VITE_ENABLE_CORS="true"
VITE_CORS_ORIGIN="http://localhost:5173"

# File uploads (matches backend: JPEG, PNG, WebP, max 2MB)
VITE_MAX_FILE_SIZE="2097152"
VITE_ALLOWED_FILE_TYPES="jpg,jpeg,png,webp"

# Logging
VITE_LOG_ENABLE_CONSOLE="true"
VITE_LOG_ENABLE_FILE="false"
