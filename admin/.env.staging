# Staging / UAT — used by: npm run build:staging
# Update URLs and keys for your staging server.

# Application
VITE_APP_NAME="Hotel Management App"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Hotel restaurant, room booking, billing, and reports"
VITE_APP_ENVIRONMENT="staging"

# API — full URL to staging Laravel API (or path prefix if same domain)
VITE_API_BASE_URL="https://staging-api.example.com"
VITE_API_TIMEOUT="30000"

# Development (off in staging)
VITE_DEBUG="false"
VITE_LOG_LEVEL="info"
VITE_ENABLE_HOT_RELOAD="false"
VITE_ENABLE_DEV_TOOLS="false"

# Build
VITE_BUILD_SOURCEMAP="true"
VITE_BUILD_MINIFY="true"

# Features
VITE_ENABLE_ANALYTICS="true"
VITE_ENABLE_ERROR_REPORTING="true"

# External services
VITE_GOOGLE_ANALYTICS_ID=""
VITE_SENTRY_DSN=""

# Security — set to your staging admin origin
VITE_ENABLE_CORS="true"
VITE_CORS_ORIGIN="https://staging-admin.example.com"

# File uploads
VITE_MAX_FILE_SIZE="2097152"
VITE_ALLOWED_FILE_TYPES="jpg,jpeg,png,webp"

# Logging
VITE_LOG_ENABLE_CONSOLE="true"
VITE_LOG_ENABLE_FILE="true"
